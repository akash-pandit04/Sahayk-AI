DATABASE_URL=postgresql+psycopg://sahayak_admin:devpassword@db:5432/sahayak_db
POSTGRES_DB=sahayak_db
POSTGRES_USER=sahayak_admin
POSTGRES_PASSWORD=devpassword
JWT_SECRET_KEY=super-secret-key-change-in-production-1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]
FIRST_ADMIN_EMAIL=admin@sahayak.local
FIRST_ADMIN_PASSWORD=adminpassword

# Gemini AI & Voice Providers (production forbids 'mock')
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_STT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
VOICE_STT_PROVIDER=mock
VOICE_TTS_PROVIDER=mock

# Privacy retention window for anonymous citizen sessions
SESSION_RETENTION_DAYS=7
